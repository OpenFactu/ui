{
  "name": "@openfactu/ui",
  "version": "0.6.1",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./charts": {
      "types": "./dist/charts/index.d.ts",
      "default": "./dist/charts/index.js"
    },
    "./qr": {
      "types": "./dist/qr/index.d.ts",
      "default": "./dist/qr/index.js"
    },
    "./ai": {
      "types": "./dist/ai/index.d.ts",
      "default": "./dist/ai/index.js"
    },
    "./styles.css": "./styles/index.css",
    "./tokens.css": "./styles/tokens.css",
    "./keyframes.css": "./styles/keyframes.css",
    "./tailwind-preset": "./tailwind/preset.cjs",
    "./package.json": "./package.json",
    "./dist/*": "./dist/*"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "styles",
    "tailwind"
  ],
  "scripts": {
    "dev": "ladle serve",
    "build": "tsc",
    "build:ladle": "ladle build",
    "typecheck": "tsc --noEmit -p tsconfig.stories.json",
    "test": "node --test \"scripts/*.test.cjs\"",
    "test:browser": "node scripts/test-browser.cjs",
    "test:erp": "node scripts/check-erp.mjs",
    "test:design": "node scripts/check-design.mjs",
    "shots": "node scripts/shots.mjs",
    "prepublishOnly": "npm run build",
    "test:operations": "node scripts/check-operations.mjs",
    "test:documents": "node scripts/check-document-pages.mjs",
    "test:workspace": "node scripts/check-workspace-kit.mjs",
    "test:data-entry": "node scripts/check-data-entry.mjs",
    "test:chat": "node scripts/test-browser.cjs chat",
    "i18n:template": "node scripts/i18n-template.cjs",
    "check:i18n": "node scripts/check-i18n.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": ">=2",
    "uqr": "^0.1.3"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.8.0",
    "react-markdown": "10.1.0",
    "react-router-dom": "^7.14.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "^2.3.0"
  },
  "devDependencies": {
    "@ladle/react": "^5.1.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.5.4",
    "jsqr": "^1.4.0",
    "playwright-core": "^1.62.0",
    "recharts": "^3.10.1",
    "tailwindcss": "^3.4.1",
    "tailwindcss-animated": "^2.1.0",
    "typescript": "^5.3.3",
    "uqr": "^0.1.3"
  },
  "peerDependenciesMeta": {
    "recharts": {
      "optional": true
    },
    "uqr": {
      "optional": true
    }
  },
  "description": "Librería de componentes React del sistema de diseño Keirost.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenFactu/ui.git"
  },
  "homepage": "https://github.com/OpenFactu/ui#readme",
  "bugs": {
    "url": "https://github.com/OpenFactu/ui/issues"
  },
  "keywords": [
    "react",
    "ui",
    "design-system",
    "componentes",
    "tailwind",
    "keirost"
  ]
}
